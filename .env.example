# ---------------------------------------------------------------------------
# Database (Railway Postgres)
# ---------------------------------------------------------------------------
# Privileged connection. Used by migrations only (scripts/migrate.mjs).
# On Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hros

# The application's own role: ordinary privileges, cannot bypass RLS.
# Created by the migration runner when APP_DB_PASSWORD is set.
# The app falls back to DATABASE_URL if this is unset, but then RLS is NOT
# enforced, because Railway's default Postgres user is a superuser.
APP_DATABASE_URL=postgresql://hr_app:password@localhost:5432/hros
APP_DB_PASSWORD=choose-a-strong-password

# Optional: connection pool ceiling (default 10).
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Object storage (Railway Bucket, S3-compatible)
# ---------------------------------------------------------------------------
# Railway provides these when you reference a Bucket from this service.
# S3_* and AWS_* equivalents are also accepted.
BUCKET=your-bucket-name
ENDPOINT=https://t3.storageapi.dev
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: there is no NODE_ENV here on purpose. `next build` and `next start` set
# it themselves, and setting NODE_ENV=production in the environment makes
# `npm ci` skip the devDependencies the build needs.
